# Source production data (ICS/ISTAT-provided; see data/raw/README.md)
data/raw/*.csv

# Raw climate data and API caches (regenerated by the ingest scripts)
data/raw/*.nc
data/raw/*.grib
data/raw/era5/
data/raw/openmeteo/

# Keep the raw-data placeholder README tracked
!data/raw/README.md

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Editor / tooling / local state
.claude/
.Rhistory

# Intermediate geo file (only the filtered Piedmont GeoJSON is needed)
data/geo/nuts3_all.geojson

# CDS credentials (never commit secrets)
.cdsapirc

